<div class="bar">
  <h1>Posts</h1>
  <a class="button" href="/admin/new">New post</a>
</div>
<% if @notice %>
<p class="notice" role="status"><%= h(@notice.to_s) %></p>
<% end %>
<% if @posts.empty? %>
<p class="empty">Nothing here yet. Write your first post.</p>
<% else %>
<table class="admin">
  <thead><tr><th>Title</th><th>Status</th><th>Date</th><th></th></tr></thead>
  <tbody>
<% @posts.each do |post| %>
    <tr>
      <td><a href="/posts/<%= h(post.slug) %>"><%= h(post.title) %></a></td>
      <td><span class="badge <%= post.published? ? "live" : "draft" %>"><%= post.published? ? "Published" : "Draft" %></span></td>
      <td><%= date(post.published_at || post.updated_at) %></td>
      <td class="actions"><a href="/admin/posts/<%= post.id %>/edit">Edit</a></td>
    </tr>
<% end %>
  </tbody>
</table>
<% end %>
<section class="backup">
  <h2>Backup</h2>
  <p>Download a copy of the whole database: every post, including drafts. Logins are not included.</p>
  <form method="post" action="/admin/backup">
    <input type="hidden" name="csrf" value="<%= h(@csrf) %>">
    <button type="submit">Download backup</button>
  </form>
</section>
