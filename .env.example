# Copy this file to .env and change ADMIN_PASSWORD. Never commit .env.
# Put the password in quotes if it has spaces. A # inside a password is fine.
ADMIN_PASSWORD=change-me

BLOG_TITLE="My Blog"
BLOG_DESCRIPTION="Notes and essays."
BLOG_AUTHOR="Admin"

# Public address of the site, used in the RSS feed and to accept form posts.
BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3000

DATABASE_PATH=data/blog.db
SESSION_DAYS=14
POSTS_PER_PAGE=10

# Cookies are marked Secure automatically when BASE_URL starts with https://.
# COOKIE_SECURE=true
