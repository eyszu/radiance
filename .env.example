# Copy to .env and change the password. Real environment variables override this file.
ADMIN_PASSWORD=change-me-to-a-long-passphrase
PORT=3000
DB_PATH=./blog.db
SITE_TITLE=Radiance
SITE_DESCRIPTION=Thoughts, notes and write-ups.
BASE_URL=http://localhost:3000
# Set to true when serving over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false
POSTS_PER_PAGE=10
